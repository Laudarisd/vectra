{
  "name": "@vectra/agent-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared host-neutral agent runtime for Vectra extension and web.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-isolation=none test/*.test.cjs"
  },
  "dependencies": {
    "deepagents": "1.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43"
  }
}
